static void tree_{{ method_index }}(const float features[], double *output) {
    int i;
    int classes[{{ n_classes }}];
    for (i = 0; i < {{ n_classes }}; i++) {
        classes[i] = 0;
    }

    {{ tree | indent(4, True) }}

    double sum = 0.0;
    for (i = 0; i < {{ n_classes }}; i++) {
        sum += classes[i];
    }
    if (sum == 0.0) {
        for (i = 0; i < {{ n_classes }}; i++) {
            output[i] = 1.0 / {{ n_classes }};
        }
    } else {
        for (i = 0; i < {{ n_classes }}; i++) {
            output[i] = classes[i] / sum;
        }
    }
}
